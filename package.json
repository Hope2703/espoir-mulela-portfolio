{
    "name": "espoir-mulela-personal-site",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "vite build && vite build --ssr",
        "build:ssr": "vite build --ssr",
        "types": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings=0",
        "test": "php artisan test && node --test tests/contrast.test.mjs",
        "check:site": "node scripts/check-site.mjs",
        "check:browser": "node scripts/check-browser.mjs",
        "check:admin": "node scripts/check-admin.mjs http://127.0.0.1:8001"
    },
    "dependencies": {
        "@fontsource-variable/manrope": "^5.3.0",
        "lucide-react": "^1.50.0",
        "motion": "^14.0.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "@inertiajs/react": "^3.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "5.9.3",
        "eslint": "^9.39.0",
        "typescript-eslint": "^8.71.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "@eslint/js": "^9.39.0",
        "globals": "^16.4.0",
        "playwright": "1.62.1",
        "@inertiajs/vite": "^3.0.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.1",
        "laravel-vite-plugin": "^3.0.0",
        "vite": "^8.0.0",
        "concurrently": "^10.0.3"
    },
    "type": "module",
    "engines": {
        "node": ">=22.18.0 <25"
    },
    "overrides": {
        "@swc/core": "1.15.11"
    }
}
