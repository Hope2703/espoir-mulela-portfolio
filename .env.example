# Application — PHP 8.4, Node 22.18+ ou 24
APP_NAME="Espoir Mulela"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
SITE_INDEXABLE=false

# PostgreSQL — activer pdo_pgsql dans PHP
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=espoir_portfolio
DB_USERNAME=postgres
DB_PASSWORD=

# Sessions/cache ; envoi synchrone initial, aucune queue obligatoire
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=info

# MailHog local ; MAIL_HOST=mailhog si les deux services tournent dans Docker
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="portfolio@espoir.test"
MAIL_FROM_NAME="${APP_NAME}"
# Vide = conservation en base sans notification par email
ADMIN_EMAIL=
# Bootstrap explicite uniquement : retirer après création du compte.
ADMIN_PASSWORD=
CONTACT_SEND_CONFIRMATION=false

# SSR Node — ne jamais exposer ce port publiquement
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
VITE_APP_NAME="${APP_NAME}"
