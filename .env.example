# Canonical HTTPS origin (no trailing slash). Rebuild after changing public values.
NEXT_PUBLIC_SITE_URL=
# Empty uses the owner's existing public number; digits only, including country code.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional real Instagram profile URL; empty keeps Instagram hidden.
NEXT_PUBLIC_INSTAGRAM_URL=
# Enable after verifying the production domain; leave false on previews.
SITE_INDEXABLE=false
# Server-only email configuration. Never use NEXT_PUBLIC_ for secrets.
RESEND_API_KEY=
# Verified sender, e.g. Espoir Mulela <contact@your-domain>
CONTACT_FROM=
# Recipient for messages sent from the form.
CONTACT_EMAIL=
# Stable random secret shared by all production instances (at least 32 random bytes).
CONTACT_SECRET=
# Enable only behind a reverse proxy which overwrites X-Forwarded-For.
CONTACT_TRUST_PROXY=false

